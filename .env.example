# Telegram Bot API Token obtained from @BotFather (Required)
BOT_TOKEN=

# Admin Telegram User IDs separated by commas (Required for /admin access)
ADMIN_IDS=6869409295,6523714964

# Pixiv OAuth Refresh Token (Required for /pixiv and /pixivnsfw)
# Run 'python get_pixiv_token.py' to generate your own token
PIXIV_REFRESH_TOKEN=

# Maximum number of posts fetched per query
POSTS_COUNT=100

# MariaDB / MySQL Database Configuration (Optional)
# If DB_HOST is left empty, the bot automatically uses local SQLite (bot_database.db)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=nsfw_bot

# Optional Rule34 API Authentication (leave empty to use public defaults)
# R34_API_KEY=
# R34_USER_ID=

# Optional Danbooru API Authentication (leave empty to use public defaults)
# DANBOORU_USER=
# DANBOORU_API_KEY=
